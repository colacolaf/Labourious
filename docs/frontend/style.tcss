/* style.tcss — Labourious theme
 *
 * Palette anchors to the colors from `preview.html` (the SPEC.md `Theme` section):
 *   Brand   cyan #8cdcdc
 *   FG      warm gray #d4d4d4
 *   FG2     soft gray #a0a5af
 *   FG3     dim gray #6e7887
 *   Border  hairline gray #465262
 *   OK      sage #8cd296
 *   WARN    amber #e6c87e
 *
 * Widget structure (after the RichLog pivot):
 *   - MessageBubble  → Container with .bubble-header Static + .bubble-body RichLog
 *   - ActivityPanel  → Container with 5 _AgentRows (Container: .row-header + .row-body)
 *   - CostWidget     → Static (header label) wrapping a small RichLog cost-body
 *   - ConnectionBanner → Static with state classes (warn/error/hide)
 *   - DiffPanel      → Container with a Collapsible wrapping a Static body
 */

Screen {
    background: #0e1014;
    color: #d4d4d4;
}

/* ---------- Header ---------- */
Header {
    background: #0e1014;
    color: #d4d4d4;
    border-bottom: solid #465262;
}

Header > .header--title  { color: #8cdcdc; text-style: bold; }
Header > .header--subtitle { color: #6e7887; }

/* ---------- Footer ---------- */
Footer {
    background: #0e1014;
    color: #6e7887;
}

Footer > .footer--key { color: #8cdcdc; }

/* ---------- Body (Sidebar | Chat) ---------- */
#body {
    height: 1fr;
    layout: horizontal;
}

/* ---------- Sidebar ---------- */
#sidebar {
    width: 30;
    background: #11141a;
    border-right: solid #465262;
    padding: 1 1;
}

.sidebar-heading {
    color: #8cdcdc;
    text-style: bold;
    margin: 1 0 0 0;
}

.sidebar-meta {
    color: #6e7887;
    margin: 0 0 1 0;
}

/* ---------- Activity panel ---------- */
ActivityPanel {
    background: #11141a;
    height: auto;
    margin: 0 0 1 0;
}

.activity-row {
    height: auto;
    color: #a0a5af;
}

ActivityPanel > .sidebar-heading {
    margin: 1 0 0 0;
}

.activity-row .row-header {
    color: #6e7887;
    text-style: bold;
    height: 1;
}

.activity-row .row-body {
    background: #11141a;
    color: #a0a5af;
    height: 1;
    margin: 0 0 1 0;
}

.row-orchestrator         .row-body { color: #8cdcdc; }
.row-senior-analyst       .row-body { color: #d4b485; }
.row-forensic-accounting  .row-body { color: #82b4e6; }
.row-devils-advocate      .row-body { color: #e19194; }
.row-final-report         .row-body { color: #a0d7a5; }

/* ---------- Cost widget ---------- */
CostWidget {
    background: #11141a;
    color: #a0a5af;
    height: auto;
    border: round #465262;
    padding: 0 1;
    margin: 0 0 1 0;
}

CostWidget > .sidebar-heading { margin: 0 0 0 0; }

CostWidget .cost-body {
    background: #11141a;
    color: #a0a5af;
    height: 3;
}

/* ---------- Chat pane ---------- */
#chat-pane {
    width: 1fr;
    layout: vertical;
}

#chat-log {
    height: 1fr;
    background: #0e1014;
    padding: 1 1 0 1;
    scrollbar-size: 1 1;
}

/* ---------- Connection banner ---------- */
ConnectionBanner {
    height: 1;
    background: #0e1014;
    color: #d4d4d4;
}

ConnectionBanner.hide { display: none; }
ConnectionBanner.warn  { color: #e6c87e; background: #1c1810; }
ConnectionBanner.error { color: #e19194; background: #1f1416; }

/* ---------- Bubbles (Container with .bubble-header + .bubble-body) ---------- */
.bubble {
    margin: 0 0 1 0;
    padding: 0 1;
    border-left: thick #465262;
    background: #11141a;
    height: auto;
    width: 100%;
    overflow: hidden;
}

.bubble-user { border-left: thick #8cdcdc; background: #11141a; }
.bubble-agent { border-left: thick #465262; }

.bubble-accent-o    { border-left: thick #8cdcdc !important; }
.bubble-accent-s    { border-left: thick #d4b485 !important; }
.bubble-accent-f    { border-left: thick #82b4e6 !important; }
.bubble-accent-d    { border-left: thick #e19194 !important; }
.bubble-accent-r    { border-left: thick #a0d7a5 !important; }
.bubble-accent-user { border-left: thick #8cdcdc !important; }
.bubble-accent-default { border-left: thick #6e7887 !important; }

.bubble-header {
    color: #6e7887;
    text-style: bold;
    height: auto;
    text-wrap: wrap;
    overflow: hidden;
    padding: 0 1 0 2;
}

.bubble-body {
    background: #11141a;
    color: #d4d4d4;
    height: auto;
    padding: 0 0 0 2;
}

/* Confidence classes — applied to the bubble container. */
.conf-high           { background: #14201c; }
.conf-moderate-high  { background: #161c1f; }
.conf-moderate       { background: #11141a; }
.conf-moderate-low   { background: #1c1810; }
.conf-low            { background: #1f1416; }
.conf-abstain        { background: #11141a; }

/* ---------- Input ---------- */
#prompt {
    background: #11141a;
    color: #d4d4d4;
    border-top: solid #465262;
    border-bottom: solid #465262;
}

#prompt Input {
    background: #11141a;
    color: #d4d4d4;
}

#prompt > .input--prompt { color: #8cdcdc; }

/* ---------- Citation chip ---------- */
CitationChip {
    background: #11141a;
    color: #a0a5af;
    border: round #465262;
    padding: 0 1;
    margin: 0 0 1 2;
    height: 1;
    width: auto;
}

CitationChip:hover {
    background: #1a1f29;
    color: #8cdcdc;
}

CitationChip.chip-empty {
    color: #6e7887;
    border: round #465262;
}

.final-chip { text-style: italic; }

/* ---------- Ticker shortcut chips ---------- */
/* Visible only when chat-log is empty; hidden after the first submit. */
TickerShortcuts {
    height: auto;
    background: transparent;
    padding: 0 1;
    margin: 0 0 1 1;
}

#ticker-shortcuts-row {
    height: auto;
    align: left middle;
}

.ticker_shortcuts_label {
    color: #6e7887;
    text-style: italic;
    padding: 0 1 0 0;
    width: auto;
}

Button.ticker_chip {
    background: #11141a;
    color: #d4b485;
    border: round #465262;
    padding: 0 2;
    margin: 0 1 0 0;
    min-width: 7;
    height: 1;
}

Button.ticker_chip:hover {
    background: #1a1f29;
    color: #f0c89a;
    border: round #8cdcdc;
}

Button.ticker_chip:focus {
    border: round #8cdcdc;
}

/* ---------- Diff panel ---------- */
DiffPanel {
    background: #11141a;
    border: round #465262;
    padding: 0 1;
    margin: 0 0 1 0;
}

Collapsible {
    background: #11141a;
}

Collapsible > .collapsible--title {
    color: #d4b485;
    text-style: bold;
}

Collapsible Static {
    background: #0e1014;
    color: #a0a5af;
}

/* ---------- Narrow / wide ---------- */
Screen.-widescreen #sidebar { width: 36; }
Screen.-narrow     #sidebar { width: 18; }

/* =============================================================== */
/* ============= Settings modal (P2 block) ======================== */
/* =============================================================== */

/* Header strip — title + breadcrumb + saved badge + file path + mtime */
#settings-head {
    background: #0e1014;
    color: #d4d4d4;
    height: 1;
    padding: 0 2;
}

.settings-head {
    background: #0e1014;
    color: #a0a5af;
    height: 1;
    padding: 0 2;
}

/* Body grid — rail (left) + main pane */
#settings-body {
    layout: horizontal;
    height: 1fr;
}

/* Left rail */
#settings-rail {
    width: 22;
    background: #11141a;
    border-right: solid #2a3441;
    padding: 1 1;
}

.rail-item {
    color: #a0a5af;
    height: 1;
    padding: 0 1 0 2;
}

.rail-item.sel {
    color: #8cdcdc;
    text-style: bold;
    background: #131c22;
}

/* Main pane — SectionCard lives here */
#settings-main {
    width: 1fr;
    background: #0e1014;
    padding: 1 2;
}

/* SectionCard — header + body */
.section-card {
    border: round #465262;
    background: #0e1014;
    height: auto;
}

.section-card-head {
    background: #11141a;
    color: #a0a5af;
    height: 1;
    padding: 0 1;
    border-bottom: solid #2a3441;
}

.section-card-body {
    background: #0e1014;
    color: #d4d4d4;
    height: auto;
    padding: 0 1 1 1;
}

/* Footer strip — keybinding hints */
#settings-foot {
    background: #0e1014;
    color: #6e7887;
    height: 1;
    padding: 0 2;
    border-top: solid #2a3441;
}

.settings-foot {
    background: #0e1014;
    color: #6e7887;
    height: 1;
    padding: 0 2;
    border-top: solid #2a3441;
}

/* ---------- Picker overlay (inline within settings) ---------- */
.picker-overlay {
    border: round #465262;
    background: #0e1014;
    height: auto;
}

.picker-breadcrumb {
    background: #11141a;
    color: #6e7887;
    height: 1;
    padding: 0 1;
}

.picker-search {
    background: #0e1014;
    color: #d4d4d4;
    height: 1;
    padding: 0 1;
    border-bottom: solid #2a3441;
}

.picker-list {
    background: #0e1014;
    color: #d4d4d4;
    height: auto;
    padding: 0 1 1 1;
}

/* ---------- Setting row visual classes (used by inline ANSI text) ---------- */
/* (Rendered inline as ANSI escape codes via SettingRow._build_main_row
   rather than separate widgets, to avoid the Static+str layout bug.) */

/* =============================================================== */
/* ============= History modal (P2 block) ======================== */
/* =============================================================== */

#history-head {
    background: #0e1014;
    color: #d4d4d4;
    height: 1;
    padding: 0 2;
}

#history-body {
    layout: horizontal;
    height: 1fr;
}

#history-list-pane {
    width: 50;
    background: #0e1014;
    border-right: solid #2a3441;
    padding: 1 1;
}

#history-list-pane RichLog { background: #0e1014; }

#history-detail-pane {
    width: 1fr;
    padding: 1 2;
}

#history-detail-pane Static {
    background: #0e1014;
    color: #d4d4d4;
    height: 1fr;
}

#history-foot {
    background: #0e1014;
    color: #6e7887;
    height: 1;
    padding: 0 2;
    border-top: solid #2a3441;
}


/* ============================================================ Inline editor
   (Settings inline-edit widgets) */

.inline-editor {
    height: auto;
    padding: 4 2 4 4;
    border-left: solid #8cdcdc;
    border-right: solid #8cdcdc;
    border-top: none;
    border-bottom: none;
    background: #0a0c10;
}

.inline-editor.err {
    border-left: solid #e1918c;
    border-right: solid #e1918c;
}

.editor-help {
    color: #6e7887;
    height: 1;
    padding: 0 0 1 0;
}

.editor-help Static {
    color: #6e7887;
}

InlineTextEditor .editor-input,
.inline-editor Input {
    background: #0e1014;
    color: #d4d4d4;
    border: solid #465262;
    height: 1;
    margin: 0;
}

.editor-input:focus,
.inline-editor Input:focus {
    border: solid #8cdcdc;
}

.editor-presets {
    color: #6e7887;
    height: 1;
    padding: 1 0 0 0;
}

/* ------------------------------------------------------------- Toggle editor */

.inline-toggle-editor {
    height: auto;
    padding: 6 4;
    border-left: solid #8cdcdc;
    border-right: solid #8cdcdc;
    background: #0a0c10;
}

.toggle-help {
    color: #6e7887;
    height: 1;
}

.toggle-display {
    height: 1;
    padding: 1 0;
}

/* ============================================================ OmniRoute setup
   (inline Settings form; endpoint/model/key/test/save all fit one pane) */

.omniroute-setup {
    height: auto;
    background: #0e1014;
    border: round #465262;
    padding: 1 2;
}

.omni-title {
    color: #8cdcdc;
    text-style: bold;
    height: 1;
}

.omni-help, .omni-label, .omni-status {
    color: #6e7887;
    height: 1;
}

.omni-fields {
    height: auto;
    padding: 1 0;
}

.omni-fields Input {
    background: #11141a;
    color: #d4d4d4;
    border: solid #465262;
    height: 1;
    margin: 0 0 1 0;
}

.omni-fields Input:focus {
    border: solid #8cdcdc;
}

.omni-actions {
    height: 1;
    align: left middle;
}

.omni-actions Button {
    min-width: 18;
    height: 1;
    margin: 0 1 0 0;
}

.omni-status.success { color: #8cd296; }
.omni-status.error { color: #e19194; }

/* ============================================================ Citation modal
   (one-screen full-width modal opened from a CitationChip) */

.modal-head {
    background: #0e1014;
    color: #d4d4d4;
    height: 1;
    padding: 0 2;
    border-bottom: solid #465262;
}

.modal-foot {
    background: #0e1014;
    color: #6e7887;
    height: 1;
    padding: 0 2;
    border-top: solid #2a3441;
}

.modal-body {
    background: #050608;
    padding: 1 2 0 2;
    height: 1fr;
}

.modal-body-log {
    background: #050608;
    height: 1fr;
    padding: 0 1;
}

#citation-body-row {
    height: 1fr;
}

.citation-toast {
    background: #0e1014;
    color: #6e7887;
    height: 1;
    padding: 0 2;
    border-top: solid #2a3441;
}

/* ============================================================ Help modal + StatusStrip
   The Help modal + the per-screen bottom StatusStrip. Both owned by
   keys.py (single source of truth for every binding). */

HelpModalScreen > .help-modal-head {
    background: #0e1014;
    color: #d4d4d4;
    height: 1;
    padding: 0 2;
    border-bottom: solid #465262;
}

HelpModalScreen > .help-modal-intro {
    background: #161a20;
    color: #a0a5af;
    height: 1;
    padding: 0 2;
}

HelpModalScreen > .help-modal-body {
    background: #050608;
    height: 1fr;
    padding: 1 2 0 2;
}

HelpModalScreen > .help-modal-grid {
    layout: horizontal;
    height: auto;
}

HelpModalScreen > .help-modal-grid > .col {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

HelpModalScreen > .help-modal-grid > .col:first-child {
    padding-left: 0;
}

HelpModalScreen > .help-modal-grid > .col:last-child {
    padding-right: 0;
}

HelpModalScreen > .help-modal-sig {
    background: #0e1014;
    color: #6e7887;
    height: 1;
    padding: 0 2;
    border-top: solid #2a3441;
}

/* Help cards inside the modal */
HelpCard {
    background: #161a20;
    border: solid #465262;
    height: auto;
    margin: 0 0 1 0;
}

HelpCard > .help-card-head {
    background: #11141a;
    color: #8cdcdc;
    text-style: bold;
    height: 1;
    padding: 0 1;
}

HelpCard > .help-card-rows > .help-row {
    height: 1;
    padding: 0 1;
    margin: 0;
}

/* StatusStrip — universal bottom strip on every screen. */
StatusStrip {
    background: #11141a;
    color: #a0a5af;
    height: 1;
    border-top: solid #2a3441;
}

StatusStrip > StatusStripLeft {
    width: 1fr;
    height: 1;
}

StatusStrip > StatusStripRight {
    width: auto;
    height: 1;
    background: #11141a;
    color: #8cdcdc;
    text-style: bold;
    padding: 0 1;
}
